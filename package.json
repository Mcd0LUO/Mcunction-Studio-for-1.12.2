{
  "name": "mcfunction-studio",
  "displayName": "Mcfunction Studio for 1.12",
  "description": "A simple mcfunction dev specialized helper for 1.12.2",
  "version": "1.6.11",
  "publisher": "Mcd0-LUO",
  "author": {
    "email": "1473522801@qq.com",
    "name": "Mcd0_LUO",
    "url": "https://github.com/Mcd0LUO/Mcunction-Studio-for-1.12.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mcd0LUO/Mcunction-Studio-for-1.12.2.git"
  },
  "bugs": {
    "url": "https://github.com/Mcd0LUO/Mcunction-Studio-for-1.12.2/issues"
  },
  "homepage": "https://github.com/Mcd0LUO/Mcunction-Studio-for-1.12.2#readme",
  "icon": "icons/main_icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:mcfunction"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mcfunction",
        "aliases": [
          "Minecraft Function",
          "mcfunction"
        ],
        "extensions": [
          "*.mcfunction"
        ],
        "filenamePatterns": [
          "**/*.mcfunction"
        ],
        "icon": {
          "light": "icons/light.png",
          "dark": "icons/dark.png"
        },
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "mcf-studio.createFunctionFile",
        "title": "新建mcfunction文件",
        "category": "Mcfunction Studio"
      },
      {
        "command": "mcf-studio.reloadWorkspace",
        "title": "刷新函数|计分板|进度|标签池",
        "category": "Mcfunction Studio"
      },
      {
        "command": "mcf-studio.fastScoreboardDebug",
        "title": "插入快速记分板debug",
        "category": "Mcfunction Studio"
      },
      {
        "command": "mcf-studio.toggleDslDebug",
        "title": "DSL管线调试: 切换日志开关",
        "category": "Mcfunction Studio"
      }
    ],
    "keybindings": [
      {
        "command": "mcf-studio.reloadWorkspace",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus && (editorLangId == mcfunction || editorLangId == yaml)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcf-studio.createFunctionFile",
          "label": "新建mcfunction文件",
          "group": "z_McfunctionStudio",
          "when": "explorerResourceIsFolder || filesExplorerFocus"
        }
      ],
      "editor/context": [
        {
          "command": "mcf-studio.fastScoreboardDebug",
          "label": "插入快速记分板debug",
          "group": "z_McfunctionStudio",
          "when": "editorTextFocus && editorLangId == mcfunction"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "McfunctionStudio.json",
        "url": "./schemas/McfunctionSutdio.schema.json"
      }
    ],
    "configuration": {
      "title": "Mcfunction Studio",
      "properties": {
        "mcfStudio.diagnostics.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "诊断规则级别覆盖。`off` 关闭该规则；未列出的规则使用其默认级别。修改后需重新打开文件生效。",
          "properties": {
            "syntax/unknown-command": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "命令不存在于 1.12.2（含 1.13+ 或模组命令）。"
            },
            "syntax/extra-token": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "参数个数多于该命令 1.12.2 语法所允许。"
            },
            "syntax/execute-run": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "execute 之后写了 1.13 的 `run` 关键字（1.12.2 在坐标之后直接接命令）。"
            },
            "syntax/unknown-inner-command": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "execute 之后接的命令不存在。"
            },
            "resource/undefined-scoreboard": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "hint",
              "markdownDescription": "选择器 `score_X` 引用的记分板目标未定义。"
            },
            "resource/undefined-scoreboard-command": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "hint",
              "markdownDescription": "`scoreboard` 命令引用了未定义的目标/队伍/标签。"
            },
            "resource/undefined-trigger": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "warning",
              "markdownDescription": "`trigger` 的目标不存在（会被游戏静默忽略）。"
            },
            "resource/undefined-function": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "`function` 引用的函数文件不存在。"
            },
            "resource/undefined-advancement": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "hint",
              "markdownDescription": "`advancement` 引用的进度不存在。"
            },
            "resource/duplicate-scoreboard": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "warning",
              "markdownDescription": "记分板目标被重复定义。"
            },
            "resource/duplicate-team": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "warning",
              "markdownDescription": "队伍被重复定义。"
            },
            "score/out-of-int32": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "warning",
              "markdownDescription": "整数超出 32 位有符号范围（记分板值上限 2147483647）。"
            },
            "scoreboard/name-too-long": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "记分板目标名超过 16 字符。"
            },
            "scoreboard/display-name-too-long": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "warning",
              "markdownDescription": "记分板显示名超过 32 字符。"
            },
            "selector/invalid-score-range": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "error",
              "markdownDescription": "`score_X_min` 大于 `score_X`，选择器恒为空集。"
            },
            "selector/invalid-count": {
              "type": "string",
              "enum": ["off", "hint", "information", "warning", "error"],
              "default": "warning",
              "markdownDescription": "选择器 `c=` 不是非负整数。"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node -e \"const d='out/dsl/global';require('fs').mkdirSync(d,{recursive:true});require('fs').cpSync('src/dsl/global',d,{recursive:true})\"",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:e2e": "npm run compile && vscode-test",
    "test:e2e:silent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e-silent.ps1",
    "test:baseline": "npm run compile && node scripts/run-baseline-tests.mjs",
    "test:index": "npm run compile && node scripts/run-index-tests.mjs",
    "test:engine": "npm run compile && node scripts/run-engine-tests.mjs",
    "test:diagnostics": "npm run compile && node scripts/run-diagnostics-tests.mjs",
    "test:purity": "npm run compile && node scripts/run-purity-tests.mjs",
    "verify:vsix": "node scripts/verify-vsix.cjs",
    "bench:baseline": "node scripts/bench-baseline.mjs",
    "bench:perf": "npm run compile && node scripts/bench-perf.mjs",
    "bench:real": "npm run compile && node scripts/bench-real-pack.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "js-yaml": "^5.2.0"
  }
}
