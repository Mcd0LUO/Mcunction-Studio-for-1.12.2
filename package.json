{
  "name": "mcfunction-studio",
  "displayName": "Mcfunction Studio for 1.12",
  "description": "A simple mcfunction dev specialized helper for 1.12.2",
  "version": "1.1.2",
  "publisher": "Mcd0-LUO",
  "author": {
    "email": "1473522801@qq.com",
    "name": "Mcd0_LUO",
    "url": "https://github.com/Mcd0LUO/Mcunction-Studio-for-1.12.2"
  },
  "icon": "icons/main_icon.png",
  
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mcfunction",
        "aliases": [
          "Minecraft Function",
          "mcfunction"
        ],
        "extensions": [
          ".mcfunction"
        ],
        "icon": {
          "light": "icons/light.png",
          "dark": "icons/dark.png"
        },
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "mcf-studio.createFunctionFile",
        "title": "新建mcfunction文件",
        "category": "Mcfunction Studio"
      },
      {
        "command": "mcf-studio.reloadWorkspace",
        "title": "刷新函数|计分板|进度|标签池",
        "category": "Mcfunction Studio"
      },
      {
        "command": "mcf-studio.checkDocCache",
        "title": "查看文档缓存",
        "category": "Mcfunction Studio"
      }
    ],
    "keybindings": [
      {
        "command": "mcf-studio.reloadWorkspace",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "editorTextFocus && editorLangId == mcfunction"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcf-studio.createFunctionFile",
          "label": "新建mcfunction文件",
          "group": "z_McfunctionStudio",
          "when": "explorerResourceIsFolder || filesExplorerFocus"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "McfunctionStudio.json",
        "url": "./schemas/McfunctionSutdio.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}