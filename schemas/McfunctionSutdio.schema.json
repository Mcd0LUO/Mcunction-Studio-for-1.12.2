{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "McfunctionStudio 配置",
    "description": "McfunctionStudio 扩展的行为控制配置",
    "type": "object",
    "properties": {
        "IgnorePattern": {
            "type": "object",
            "description": "需要忽略的模式配置（函数和进度）",
            "properties": {
                "Function": {
                    "type": "array",
                    "description": "需要忽略的函数模式列表 [填写相对于functions的文件路径\n如文件夹: **/misc 或 system/misc\n文件:  **/misc/init.mcfunction    ]",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "Advancement": {
                    "type": "array",
                    "description": "需要忽略的进度模式列表",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "Macro": {
                    "type": "array",
                    "description": "需要忽略的宏定义文件模式列表",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                }
            },
            "required": [
                "Function",
                "Advancement",
                "Macro"
            ],
            "additionalProperties": false
        },
        "FileProcessing": {
            "type": "object",
            "description": "文件处理相关设置",
            "properties": {
                "MaxConcurrentReads": {
                    "type": "number",
                    "description": "最大并发读取文件数",
                    "default": 100
                },
                "AutoRenameFunctionReference": {
                    "type": "boolean",
                    "description": "自动重命名函数引用",
                    "default": true
                }
            }
        },
        "Signature": {
            "type": "boolean",
            "description": "是否启用签名提示功能",
            "default": true
        },
        "JsonPreview": {
            "type": "object",
            "description": "JSON预览相关设置",
            "properties": {
                "LinePreview": {
                    "type": "boolean",
                    "description": "是否启用JSON行内预览",
                    "default": true
                },
                "HoverPreview": {
                    "type": "boolean",
                    "description": "是否启用JSON悬停预览",
                    "default": true
                }
            },
            "required": [
                "LinePreview",
                "HoverPreview"
            ],
            "additionalProperties": false
        },
        "CommandSchemaCheck": {
            "type": "boolean",
            "description": "是否启用命令语法校验",
            "default": true
        },
        "HoverProvider": {
            "type": "object",
            "description": "悬停提示相关设置",
            "properties": {
            }

        }
    },
    "required": [
        "IgnorePattern",
        "Signature",
        "JsonPreview",
        "FileProcessing",
        "CommandSchemaCheck",
        "HoverProvider"
    ],
    "additionalProperties": false
}